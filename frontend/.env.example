VITE_API_URL=/api/v1
VITE_BRAND_NAME=CampaignsHub
VITE_BRAND_DOMAIN=campaignshub.io

# Influencer & UGC — off in this release (INFL-OFF-001). The portal, its pages and its data all
# remain; only the OFFER is withdrawn. Set to `true` to bring it back. The backend enforces the same
# switch through FEATURE_INFLUENCERS_UGC — this one only decides what the interface advertises.
VITE_INFLUENCERS_UGC=false
