APP_NAME=CampaignsHub
APP_ENV=local
E2E_RELAX_RATE_LIMITS=false
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Brand / domain identity (central; see config/brand.php). Change here, never hard-code in code.
APP_BRAND_NAME=CampaignsHub
APP_DOMAIN=campaignshub.io
APP_MARKETING_URL=https://campaignshub.io
APPLICATION_URL=https://app.campaignshub.io
API_URL=https://api.campaignshub.io
DOCS_URL=https://docs.campaignshub.io
STATUS_URL=https://status.campaignshub.io
SUPPORT_EMAIL=support@campaignshub.io

# Decoupled SPA origin (used by CORS + Sanctum stateful auth). See ADR 0001.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (create the database first: `createdb mediabuying`).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mediabuying
DB_USERNAME=postgres
DB_PASSWORD=

# Redis-backed session/cache/queue. Uses the pure-PHP predis client by default (no ext-redis needed).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Report exports — headless Chromium renderer (REQUIRED for client/creative reports; the exporter
# fail-closes for client PDFs when this is off rather than shipping the plain Dompdf fallback).
REPORTS_CHROMIUM_ENABLED=true
REPORTS_PRINT_APP_URL=http://localhost:5173
# REPORTS_REQUIRE_BASE=   # unset → defaults to ../frontend/package.json (sibling layout)
# Login rate limit (per minute, per IP). Production stays strict; local/CI gets headroom for repeat E2E runs.
AUTH_LOGIN_THROTTLE=6
AUTH_LOGIN_THROTTLE_LOCAL=60

# Influencer & UGC — off in this release (INFL-OFF-001). Nothing is deleted: the portal's tables,
# models, controllers and tests all stay, and existing influencer requests keep their service type
# and their history. What this withdraws is the OFFER — the portal gate, the registration options,
# the demo logins and the ability to open a NEW request for the module.
FEATURE_INFLUENCERS_UGC=false
