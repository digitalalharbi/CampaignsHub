APP_NAME=CampaignsHub
APP_ENV=local
E2E_RELAX_RATE_LIMITS=false
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Brand / domain identity (central; see config/brand.php). Change here, never hard-code in code.
APP_BRAND_NAME=CampaignsHub
APP_DOMAIN=campaignshub.io
APP_MARKETING_URL=https://campaignshub.io
APPLICATION_URL=https://app.campaignshub.io
API_URL=https://api.campaignshub.io
DOCS_URL=https://docs.campaignshub.io
STATUS_URL=https://status.campaignshub.io
# The platform writes from, and is written to at, ONE address. `support@` was a second
# address nobody holds — printed on the contact page, so a customer would have written to it.
SUPPORT_EMAIL=info@campaignshub.io

# Decoupled SPA origin (used by CORS + Sanctum stateful auth). See ADR 0001.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (create the database first: `createdb mediabuying`).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mediabuying
DB_USERNAME=postgres
DB_PASSWORD=

# Redis-backed session/cache/queue. Uses the pure-PHP predis client by default (no ext-redis needed).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@campaignshub.io"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Report exports — headless Chromium renderer (REQUIRED for client/creative reports; the exporter
# fail-closes for client PDFs when this is off rather than shipping the plain Dompdf fallback).
REPORTS_CHROMIUM_ENABLED=true
REPORTS_PRINT_APP_URL=http://localhost:5173
# REPORTS_REQUIRE_BASE=   # unset → defaults to ../frontend/package.json (sibling layout)
# Login rate limit (per minute, per IP). Production stays strict; local/CI gets headroom for repeat E2E runs.
AUTH_LOGIN_THROTTLE=6
AUTH_LOGIN_THROTTLE_LOCAL=60

# Influencer & UGC — off in this release (INFL-OFF-001). Nothing is deleted: the portal's tables,
# models, controllers and tests all stay, and existing influencer requests keep their service type
# and their history. What this withdraws is the OFFER — the portal gate, the registration options,
# the demo logins and the ability to open a NEW request for the module.
FEATURE_INFLUENCERS_UGC=false

# Which gateway takes the PLATFORM's subscription money: moyasar | stripe | sandbox.
# `sandbox` is for installations with no credentials — it signs and verifies a real webhook over a
# local secret so the payment path can be walked, and is inert in production.
SUBSCRIPTION_PROVIDER=moyasar

# Moyasar — the primary gateway. Left EMPTY on purpose: no real key belongs in a file that is
# committed, and an empty key is not a broken install. `isConfigured()` returns false, no checkout
# opens, no webhook can verify, and the product reports READY_FOR_CREDENTIALS rather than pretending.
#
#   - The PUBLISHABLE key is the browser's, and is the only one that may ever reach the frontend.
#   - The SECRET key is the server's alone. It must never appear in a bundle, a log or an API response.
#   - The WEBHOOK token is what makes a confirmation trustworthy. A secret key without it would open
#     checkouts that nothing can ever confirm — money leaves the customer and no account activates —
#     so `production:check` refuses that combination outright.
#   - Test and live keys must MATCH each other. `sk_live_…` beside `pk_test_…` is the mismatch that
#     produces «it succeeded in the browser and never existed on the server».
#
# Test keys carry `_test`; live keys do not. `php artisan production:check` fails a production
# install that is still holding a test key.
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_TOKEN=
#
# MOYASAR_SECRET_KEY is needed for two things, not one. It opens the invoice, and it is also how the
# product RE-READS a charge from `GET /v1/payments/{id}` before settling it (PAY-CONFIRM-001).
#
# That second use is not optional here. A Moyasar webhook authenticates with the shared token above,
# carried inside the body it is meant to authenticate — so a verified event proves the sender knew a
# secret and says nothing about the amount, currency or status beside it. The product therefore asks
# Moyasar directly, over its own connection, before any money counts. With the secret key absent or
# wrong, confirmations cannot be fetched and NOTHING settles: charges stay open and the audit log
# fills with `subscription.payment.unconfirmed`. That is the intended failure — it is far better than
# activating accounts on a body anybody holding the token could have written.
#
# Register this URL as the webhook endpoint in the Moyasar dashboard:
#   POST {APP_URL}/api/v1/payments/webhook/moyasar
# and put the token it shows you into MOYASAR_WEBHOOK_TOKEN.
#
# A LIVE key outside production is refused too, and it is the more expensive mistake: a laptop, a
# staging box or a CI run holding `sk_live_…` charges real cards against a database that is thrown
# away nightly. Copying a working production `.env` is how most staging environments start, so
# `production:check` fails on it wherever APP_ENV is not `production`.
#
# ── Automatic renewal (PAY-TOKEN-003) ──
#
# There is NO environment variable for this. Whether a renewal is taken from a card on file depends
# on whether Moyasar issues a reusable token with the payments this merchant account settles: when it
# does, the verified webhook files the card and the next renewal is debited; when it does not, every
# renewal arrives as an invoice the customer visits and pays. Both are honest states, and
# `/admin/settings` reports which one this install is in, together with how many cards actually exist.
#
# Nothing here ever accepts a card number, and there is no endpoint that adds a saved card — a token
# arrives one way only, from a payment the gateway settled.

# Stripe — supported by the same port, and unconfigured here. Same rules as above.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Production ────────────────────────────────────────────────────────────────
#
# The values above are the LOCAL ones. A deployment on campaignshub.io must override
# these, and each of them is load-bearing rather than cosmetic:
#
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://campaignshub.io
#   FRONTEND_URL=https://campaignshub.io
#
#   # Sanctum treats a request as session-authenticated only when its Origin appears here.
#   # A missing entry does not error — it returns 401, which reads as an authentication defect.
#   SANCTUM_STATEFUL_DOMAINS=campaignshub.io,app.campaignshub.io
#
#   # A leading dot shares the session across app./api. subdomains. Without it a customer signing in
#   # on one host arrives at the other as a guest.
#   SESSION_DOMAIN=.campaignshub.io
#   SESSION_SECURE_COOKIE=true     # the session cookie must never travel in clear text
#   SESSION_SAME_SITE=lax          # `none` would let any site send it; `strict` breaks return-from-payment
#
#   MAIL_FROM_ADDRESS=info@campaignshub.io
#   SUPPORT_EMAIL=info@campaignshub.io
#
#   QUEUE_CONNECTION=redis         # sync would run reports and syncs inside the web request
#   CACHE_STORE=redis
#   DB_CONNECTION=pgsql
#
# Run `php artisan production:check` in the deploy pipeline BEFORE traffic moves. It exits non-zero
# on anything above being wrong, and on a gateway that is still holding a test key or has no webhook
# secret. It reports the SHAPE of a key and never its value.
#
# Company identity — legal name, registration number, jurisdiction, address — is NOT here. It is
# database-backed and edited at /admin/settings, because it is a fact about the company rather than
# about the deployment, and because inventing a plausible default for it would put a made-up
# registration number on a published privacy policy.
