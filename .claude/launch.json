{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--host=127.0.0.1",
        "--port=8000"
      ],
      "cwd": "backend",
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "cwd": "frontend",
      "port": 4173
    },
    {
      "name": "objpaths-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DB_DATABASE=mediabuying_objpaths",
        "APP_ENV=local",
        "APP_URL=http://127.0.0.1:8197",
        "FRONTEND_URL=http://localhost:5297",
        "SANCTUM_STATEFUL_DOMAINS=localhost:5297,127.0.0.1:5297",
        "php",
        "artisan",
        "serve",
        "--host=127.0.0.1",
        "--port=8197"
      ],
      "cwd": "backend",
      "port": 8197,
      "autoPort": false
    },
    {
      "name": "objpaths-web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_TARGET=http://127.0.0.1:8197",
        "npx",
        "vite",
        "--port",
        "5297",
        "--strictPort"
      ],
      "cwd": "frontend",
      "port": 5297,
      "autoPort": false
    }
  ]
}