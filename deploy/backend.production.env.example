APP_NAME=CampaignsHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.campaignshub.io

APP_BRAND_NAME=CampaignsHub
APP_DOMAIN=campaignshub.io
APP_MARKETING_URL=https://campaignshub.io
APPLICATION_URL=https://campaignshub.io
API_URL=https://api.campaignshub.io
DOCS_URL=https://campaignshub.io/docs
STATUS_URL=https://campaignshub.io/status
SUPPORT_EMAIL=info@campaignshub.io

FRONTEND_URL=https://campaignshub.io
SANCTUM_STATEFUL_DOMAINS=campaignshub.io,www.campaignshub.io
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.campaignshub.io
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=campaignshub
DB_USERNAME=campaignshub
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_SSLMODE=prefer
DB_TIMEZONE=UTC

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=info@campaignshub.io
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@campaignshub.io
MAIL_FROM_NAME="CampaignsHub"
MAIL_REPLY_TO=info@campaignshub.io
NOTIFICATION_EMAIL_PROVIDER=App\Domains\Notifications\Providers\LaravelMailProvider

REPORTS_CHROMIUM_ENABLED=false
REPORTS_PRINT_APP_URL=https://campaignshub.io
AUTH_LOGIN_THROTTLE=6
FEATURE_INFLUENCERS_UGC=false

SUBSCRIPTION_PROVIDER=sandbox
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_TOKEN=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
