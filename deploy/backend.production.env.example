APP_NAME=CampaignsHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.campaignshub.io

APP_BRAND_NAME=CampaignsHub
APP_DOMAIN=campaignshub.io
APP_MARKETING_URL=https://campaignshub.io
APPLICATION_URL=https://campaignshub.io
API_URL=https://api.campaignshub.io
DOCS_URL=https://campaignshub.io/docs
STATUS_URL=https://campaignshub.io/status
SUPPORT_EMAIL=info@campaignshub.io

FRONTEND_URL=https://campaignshub.io
SANCTUM_STATEFUL_DOMAINS=campaignshub.io,www.campaignshub.io
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.campaignshub.io
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Dedicated CampaignsHub Login OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.campaignshub.io/api/v1/auth/oauth/google/callback

# Existing CampaignsHub Twilio Verify Service. Values belong in the deployment secret store only.
# Optional, so commented: an uncommented key here is a contract the live env file must already meet, and these
# blocked every deploy after #877. config/services.php and config/accounts.php default the channel (sms) and the
# resend cooldown (60); without the three credentials Twilio Verify is simply not configured.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_VERIFY_CHANNEL=sms
# NOTIFICATION-CHANNELS-001 — WhatsApp notifications over the same Twilio account. Optional and COMMENTED: with none of
# these set the Null adapter stays registered and nothing is ever attempted. Needs a WhatsApp-enabled sender (or a Messaging
# Service) and approved Content templates; TWILIO_WHATSAPP_CONTENT_SIDS is a JSON map of "ch_<type>.<ar|en>" to the HX... SID.
# TWILIO_WHATSAPP_FROM=+966500000000
# TWILIO_WHATSAPP_MESSAGING_SERVICE_SID=
# TWILIO_WHATSAPP_CONTENT_SIDS={}
# REGISTRATION_MOBILE_RESEND_COOLDOWN_SECONDS=60
# SIGNUP-VERIFY-POLICY-001: applications per hour per IP, applied only while the signup email gate is off.
# REGISTRATION_UNVERIFIED_PER_HOUR=20
# REGISTRATION_UNVERIFIED_PER_HOUR_LOCAL=1000

# Existing Google Ads OAuth client in Cloud project 741831383514; do not rotate during deployment.
# Preserve any legacy developer-token value, although current access follows the Cloud project.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
AD_PLATFORM_REDIRECT_BASE=https://api.campaignshub.io
# GA4 uses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET (sign-in client). Only for a SEPARATE client, set both together:
# GA4_CLIENT_ID=
# GA4_CLIENT_SECRET=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=campaignshub
DB_USERNAME=campaignshub
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_SSLMODE=prefer
DB_TIMEZONE=UTC

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# SNAP-STRUCTURE-RETRY-001 — leave this unset unless you have a reason. The application default (1200)
# is derived from the longest job's timeout; anything below it makes Redis re-deliver work that is
# still running. If you do set it, it must stay above every job timeout — see config/queue.php.
# REDIS_QUEUE_RETRY_AFTER=1200
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=info@campaignshub.io
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@campaignshub.io
MAIL_FROM_NAME="CampaignsHub"
MAIL_REPLY_TO=info@campaignshub.io
NOTIFICATION_EMAIL_PROVIDER=App\Domains\Notifications\Providers\LaravelMailProvider
# EMAIL-GAPS — optional, with safe defaults in config/. The first four mail real people when switched on; each needs the Owner's approval.
# NEW_SIGN_IN_ALERT_ENABLED=false
# REPORT_SCHEDULE_MAIL_ENABLED=false
# REPORT_SCHEDULE_MAIL_OUTSIDE_RECIPIENTS=false
# REQUEST_CLIENT_MAIL_ENABLED=false
# MAIL_DAILY_LIMIT_PER_TENANT=1000
# EMAIL-TEST-SEND-001 — it only ever holds mail back; 0 switches it off.
# MAIL_ALERT_REPEATS_PER_DAY=3

# REPORT-EXPORT-FUNCTIONAL-001 — the renderer is provisioned, so it is ON.
#
# This said `false`, and the deployment checklist offered a fork: provision a
# headless browser, OR disable it and show «PDF export unavailable». Production
# took the second half without the second half's honesty — the export button was
# still offered, the job failed, and the interface redrew the button. The image
# now carries the browser, Node and the python text-layer pass, so the truthful
# value is `true`.
REPORTS_CHROMIUM_ENABLED=true
REPORTS_PRINT_APP_URL=https://campaignshub.io
# The DISTRO browser: Playwright ships glibc builds and the image is musl, so the
# supported path is Alpine's chromium plus an explicit executable path.
REPORTS_CHROMIUM_PATH=/usr/bin/chromium
REPORTS_NODE_BIN=node
# `playwright-core` lives beside the image's own print runtime; the default points
# at a developer's `../frontend/package.json`, which no server has.
REPORTS_REQUIRE_BASE=/opt/print/package.json
REPORTS_PYTHON_BIN=python3
# Provenance that names the renderer HONESTLY. `ReportDownloadController` refuses
# any PDF whose stamp disagrees with this value, which is also what retires the
# files made before the renderer existed here.
REPORTS_RENDERER_VERSION=alpine-chromium-136
# PERF-RECOVERY-001 — a public live link answers from its last confirmed build and refreshes it on the
# `live-refresh` queue (worked by supervisor-sync). OFF until the Owner turns it on; switching on is this one
# line set to true. The bound is 900 s (config/reports.php): an older build is never served.
# REPORTS_LIVE_CACHE_ENABLED=false
AUTH_LOGIN_THROTTLE=6
FEATURE_INFLUENCERS_UGC=false

SUBSCRIPTION_PROVIDER=sandbox
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_TOKEN=
# SCHEDULE-REGISTERED-001 — the nightly subscription lifecycle acts in production only when this is true; absent means false.
# Commented out on purpose: env-contract requires every UNcommented key to exist on the server, and absent is the safe value.
# Read `php artisan subscriptions:lifecycle` (its preview) before setting it.
# SUBSCRIPTION_LIFECYCLE_ENABLED=true
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# INTEG-SYNC-ENGINE-001: request budget per hour for sync jobs. The defaults (config/integrations.php) are a brake one worker cannot reach; unset keeps them.
# SYNC_BUDGET_ENABLED=true
# SYNC_BUDGET_WINDOW_SECONDS=3600
# SYNC_BUDGET_PROVIDER_REQUESTS=30000
# SYNC_BUDGET_CONNECTION_REQUESTS=15000
# SYNC_BUDGET_CONNECTION_SHARE=0.5
# SYNC_BUDGET_META_REQUESTS=
# SYNC_BUDGET_SNAPCHAT_REQUESTS=
# SYNC_BUDGET_TIKTOK_REQUESTS=
# SYNC_BUDGET_GOOGLE_REQUESTS=
# SYNC_BUDGET_LINKEDIN_REQUESTS=
# SYNC_BUDGET_X_REQUESTS=
# SYNC_BUDGET_OPENAI_ADS_REQUESTS=
# SYNC_BUDGET_MAX_HOLD_SECONDS=3600
# SYNC_BUDGET_META_USAGE_HOLD_PERCENT=100
# SYNC_BUDGET_CACHE_STORE=
# INTEG-SYNC-ENGINE-001: how far a scheduled sweep reaches back to its checkpoint after a gap, and how often a read that landed nothing new may repeat.
# SYNC_RESUME_MAX_DAYS=35
# SYNC_RESUME_COOLDOWN_HOURS=24

# LOGIN-SINGLE-DOOR-001: offer the email code on /login and open /client/login/*. Off unless an operator decides otherwise.
# PORTAL_CODE_ON_LOGIN=false

# MONEY-CURRENCY-NEVER-ASSUMED-001 / MONEY-FX-FLOATING-001 — the exchange-rate source for FLOATING currencies
# (EUR, TRY, …). Pegged currencies (SAR, AED, QAR, BHD, OMR, JOD) need no source: `fx:rates` records their legal
# peg itself. Commented out on purpose: env-contract requires every UNcommented key to exist on the server, and
# unset is the deliberate default (config/fx.php — choosing a publisher is the Owner's decision). To turn the
# free, keyless European Central Bank euro reference rates on, set the two lines below on the server; the
# scheduled `fx:rates` (02:30) then fills every withheld pair the data needs, back to its earliest withheld
# day, and `metrics:renormalise-currency --apply` converts the rows already withheld. The ECB publishes USD and
# TRY (EUR is its base); it does NOT publish EGP or SAR — EGP needs a hand-entered rate in /admin or another source.
# FX_RATE_DRIVER=App\Domains\Metrics\Rates\EcbReferenceRates
# FX_RATE_STALE_AFTER_DAYS=3


# PERF-RECOVERY-001: a sweep writes only rows that are new or changed. Leave unset (on); false writes every row again as before.
# SYNC_SKIP_UNCHANGED_ROWS=true
# PERF-RECOVERY-001: minutes (0 to 20) over which the half-hourly sweep spreads its accounts. Unset or 0 queues them all at :00 and :30.
# SYNC_SWEEP_SPREAD_MINUTES=20

# INTEG-WEBHOOK-ENGINE-001 — webhook hardening. Both keys are OPTIONAL and commented on purpose: an uncommented
# key is a contract the live env file must already meet, and a new one blocks the deploy. Defaults are in
# config/integrations.php. The reconciliation command (`webhooks:reconcile`, every six hours at :40) is always
# listed in the scheduler but runs only when the first line is set true: it reads each bound Salla/Zid store's
# recent orders (read-only toward the provider, 20 stores and 3 days per run) and records differences in the
# webhook inbox. The second is how old a SIGNED delivery may be before it is refused as a replay (default 48 h).
# WEBHOOK_RECONCILE_ENABLED=false
# WEBHOOK_REPLAY_TOLERANCE_SECONDS=172800

# INTEG-SOURCE-REMOVAL-001 — lets the daily sweep HIDE connections started in the wizard and never finished (no selection, no sync, no data).
# Commented out on purpose: absent means false, and an uncommented new key blocks every deploy. Read `php artisan integrations:sweep-abandoned` first.
# INTEGRATIONS_ABANDONED_SWEEP_ENABLED=true

# PLATFORM-SERVICE-INBOX-001 — optional. The hosts that ARE CampaignsHub; a service request arriving on one of them
# is owned by the platform. Unset, the site, application and API hosts from the brand settings are used.
# REQUESTS_PLATFORM_HOSTS=campaignshub.io,www.campaignshub.io,api.campaignshub.io
# REQUESTS_PLATFORM_INBOX_NOTIFY=true
